<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.audiofix</groupId>
    <artifactId>audiofix</artifactId>
    <version>1.1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.4</javafx.version>
        <jackson.version>2.22.3</jackson.version>
        <junit.version>6.1.3</junit.version>
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.5</logback.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>pl/audiofix/version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>pl/audiofix/version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <systemPropertyVariables>
                        <project.version>${project.version}</project.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>pl.audiofix.Launcher</mainClass>
                    <options>
                        <option>--enable-native-access=ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Windows installer with its own Java runtime (#14): mvn -Pinstaller package
            The .exe needs WiX Toolset (https://wixtoolset.org); without it build a folder with AudioFix.exe:
            mvn -Pinstaller package -Dinstaller.type=app-image
        -->
        <profile>
            <id>installer</id>
            <properties>
                <installer.type>exe</installer.type>
                <installer.input>${project.build.directory}/jpackage/input</installer.input>
                <installer.output>${project.build.directory}/installer</installer.output>
                <!--
                    ffmpeg shipped with the installer (#24): LGPL "shared" build from https://github.com/BtbN/FFmpeg-Builds,
                    a month-end autobuild (those stay), so every build packs the same files. To update: pick a newer
                    release, copy the name of its win64-lgpl-shared zip and its line from checksums.sha256.
                -->
                <ffmpeg.release>autobuild-2026-09-30-13-08</ffmpeg.release>
                <ffmpeg.name>ffmpeg-n8.1.3-9-g29e619e767-win64-lgpl-shared-8.1</ffmpeg.name>
                <ffmpeg.sha256>3e47bda1607740550141e37c0e49d1e5182b34699f15adfd137ee266d346811a</ffmpeg.sha256>
                <!-- jdeps finds the first six; locale data (Polish and English only, see jlink options) keeps "32,4 GB" Polish, the rest are used through reflection -->
                <installer.modules>java.base,java.desktop,java.prefs,java.scripting,java.sql,jdk.jfr,java.logging,java.naming,jdk.unsupported,jdk.localedata,jdk.charsets</installer.modules>
            </properties>
            <build>
                <plugins>
                    <!-- jpackage takes only digits: 1.0.0-SNAPSHOT becomes 1.0.0 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>installer-version</id>
                                <goals>
                                    <goal>parse-version</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- jpackage refuses to write over an existing image, so the old one goes first -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>installer-clean</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <!-- jpackage makes AudioFix.exe read-only -->
                                    <force>true</force>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/jpackage</directory>
                                        </fileset>
                                        <fileset>
                                            <directory>${installer.output}</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- downloaded once (the plugin keeps a copy in ~/.m2), checked against the checksum, unpacked -->
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.13.0</version>
                        <executions>
                            <execution>
                                <id>installer-ffmpeg-download</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>wget</goal>
                                </goals>
                                <configuration>
                                    <uri>https://github.com/BtbN/FFmpeg-Builds/releases/download/${ffmpeg.release}/${ffmpeg.name}.zip</uri>
                                    <sha256>${ffmpeg.sha256}</sha256>
                                    <unpack>true</unpack>
                                    <outputDirectory>${project.build.directory}/ffmpeg</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- the app jar and every runtime jar in one folder: jpackage puts them all on the classpath -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.9.0</version>
                        <executions>
                            <execution>
                                <id>installer-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${installer.input}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>installer-app-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${installer.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <!-- lands in <installation>\app\ffmpeg, where FfmpegLocator looks for it -->
                            <execution>
                                <id>installer-ffmpeg</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${installer.input}/ffmpeg</outputDirectory>
                                    <resources>
                                    <!-- the two programs and the libraries they share; no ffplay, docs or headers -->
                                        <resource>
                                            <directory>${project.build.directory}/ffmpeg/${ffmpeg.name}/bin</directory>
                                            <includes>
                                                <include>ffmpeg.exe</include>
                                                <include>ffprobe.exe</include>
                                                <include>*.dll</include>
                                            </includes>
                                        </resource>
                                        <!-- LGPL: the license goes with the binaries -->
                                        <resource>
                                            <directory>${project.build.directory}/ffmpeg/${ffmpeg.name}</directory>
                                            <includes>
                                                <include>LICENSE.txt</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>installer-jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${installer.type}</argument>
                                        <argument>--name</argument>
                                        <argument>AudioFix</argument>
                                        <argument>--app-version</argument>
                                        <argument>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                                        <argument>--vendor</argument>
                                        <argument>AudioFix</argument>
                                        <!-- English: the MSI holds only the Windows-1252 code page, Polish letters break WiX (LGHT0311) -->
                                        <argument>--description</argument>
                                        <argument>Converts DTS and TrueHD audio tracks in films so a TV can play them</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/installer/AudioFix.ico</argument>
                                        <argument>--input</argument>
                                        <argument>${installer.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>pl.audiofix.Launcher</argument>
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--add-modules</argument>
                                        <argument>${installer.modules}</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-man-pages --no-header-files --compress=zip-6 --include-locales=pl,en</argument>
                                        <argument>--dest</argument>
                                        <argument>${installer.output}</argument>
                                        <!-- Start menu, shortcut, per-user install, about URL: jpackage takes them only for the exe -->
                                        <argument>@${project.basedir}/src/installer/${installer.type}.args</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>