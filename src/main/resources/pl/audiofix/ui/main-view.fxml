<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import pl.audiofix.ui.Icon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="pl.audiofix.ui.MainController" fx:id="rootPane" styleClass="drop-target">
    <top>
        <HBox fx:id="toolBar" styleClass="tool-bar" alignment="CENTER_LEFT">
            <Button fx:id="addFilesButton" text="Dodaj pliki…" minWidth="-Infinity" onAction="#onAddFiles">
                <graphic><Icon glyph="ADD"/></graphic>
            </Button>
            <Button fx:id="ffmpegSettingsButton" text="Ustawienia ffmpeg" minWidth="-Infinity" onAction="#onFfmpegSettings">
                <graphic><Icon glyph="SETTINGS"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="aboutButton" text="O programie" minWidth="-Infinity" onAction="#onAbout">
                <graphic><Icon glyph="ABOUT"/></graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.25" styleClass="workspace">
            <VBox fx:id="queuePanel" styleClass="panel" minWidth="220" prefWidth="270" SplitPane.resizableWithParent="false">
                <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="queueTitleLabel" text="Kolejka plików (0)" styleClass="section-header" minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="queueRemainingLabel" text="Pozostało: 0" styleClass="panel-note" minWidth="-Infinity"/>
                </HBox>
                <ListView fx:id="queueList" VBox.vgrow="ALWAYS"/>
                <HBox styleClass="panel-footer" alignment="CENTER_LEFT">
                    <Button fx:id="removeFromQueueButton" text="Usuń z kolejki" minWidth="-Infinity" styleClass="button-danger" onAction="#onRemoveFromQueue">
                        <graphic><Icon glyph="REMOVE"/></graphic>
                    </Button>
                </HBox>
            </VBox>
            <VBox fx:id="tracksPanel" styleClass="panel">
                <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="tracksTitleLabel" text="Ścieżki" styleClass="section-header" minWidth="-Infinity"/>
                    <Label fx:id="tracksFileLabel" styleClass="file-name" textOverrun="CENTER_ELLIPSIS" ellipsisString="…"/>
                    <Label fx:id="tracksInfoLabel" styleClass="panel-note" minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="trackCountLabel" styleClass="panel-note" minWidth="-Infinity"/>
                    <Button fx:id="applyToAllButton" text="Zastosuj do wszystkich" minWidth="-Infinity" onAction="#onApplyToAll">
                        <tooltip>
                            <Tooltip text="Kopiuje „Zostaw”, akcję i ścieżki domyślne do pozostałych oczekujących plików z tym samym układem ścieżek."/>
                        </tooltip>
                    </Button>
                </HBox>
                <TableView fx:id="trackTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="keepColumn" text="Zostaw"/>
                        <TableColumn fx:id="indexColumn" text="#"/>
                        <TableColumn fx:id="typeColumn" text="Typ"/>
                        <TableColumn fx:id="codecColumn" text="Kodek"/>
                        <TableColumn fx:id="channelsColumn" text="Kanały"/>
                        <TableColumn fx:id="languageColumn" text="Język"/>
                        <TableColumn fx:id="titleColumn" text="Tytuł"/>
                        <TableColumn fx:id="actionColumn" text="Akcja"/>
                        <TableColumn fx:id="defaultColumn" text="Domyślna"/>
                    </columns>
                </TableView>
                <HBox styleClass="panel-footer" alignment="CENTER_LEFT" spacing="8">
                    <Label text="Plik wyjściowy:" styleClass="field-label" minWidth="-Infinity"/>
                    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <TextField fx:id="outputField" HBox.hgrow="ALWAYS" styleClass="path-field,joined-left"/>
                        <Button fx:id="changeOutputButton" text="Zmień…" minWidth="-Infinity" styleClass="joined-right" onAction="#onChangeOutput"/>
                    </HBox>
                    <Button fx:id="outputFolderButton" text="Folder dla wszystkich…" minWidth="-Infinity" onAction="#onOutputFolderForAll">
                        <tooltip>
                            <Tooltip text="Zapisuje wszystkie oczekujące pliki do wybranego folderu, z zachowaniem ich nazw."/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <VBox styleClass="action-bar" spacing="8">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="startButton" text="Start" minWidth="-Infinity" styleClass="button-primary" onAction="#onStart">
                    <graphic><Icon glyph="START"/></graphic>
                </Button>
                <Button fx:id="quickConvertButton" text="Szybka konwersja" minWidth="-Infinity" styleClass="button-warning" onAction="#onQuickConvert">
                    <graphic><Icon glyph="QUICK"/></graphic>
                    <tooltip>
                        <Tooltip text="Wideo + jedna ścieżka audio (najwięcej kanałów) jako PCM 24-bit, bez edycji ścieżek. Pozostałe ścieżki audio i napisy obrazkowe zostaną pominięte."/>
                    </tooltip>
                </Button>
                <Button fx:id="cancelButton" text="Anuluj" minWidth="-Infinity" onAction="#onCancel"/>
                <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TextArea fx:id="logArea" styleClass="console" editable="false" prefRowCount="6"/>
        </VBox>
    </bottom>
</BorderPane>