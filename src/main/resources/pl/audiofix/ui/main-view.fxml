<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import pl.audiofix.ui.Icon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="pl.audiofix.ui.MainController" fx:id="rootPane" styleClass="drop-target">
    <top>
        <HBox fx:id="toolBar" styleClass="tool-bar" alignment="CENTER_LEFT">
            <Button fx:id="addFilesButton" text="%toolbar.addFiles" minWidth="-Infinity" onAction="#onAddFiles">
                <graphic><Icon glyph="ADD"/></graphic>
            </Button>
            <Button fx:id="ffmpegSettingsButton" text="%toolbar.ffmpegSettings" minWidth="-Infinity" onAction="#onFfmpegSettings">
                <graphic><Icon glyph="SETTINGS"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="language-switch" alignment="CENTER">
                <fx:define>
                    <ToggleGroup fx:id="languageGroup"/>
                </fx:define>
                <ToggleButton fx:id="polishButton" text="%toolbar.language.polish" styleClass="joined-left" minWidth="-Infinity" toggleGroup="$languageGroup">
                    <tooltip>
                        <Tooltip text="%toolbar.language.polish.tooltip"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="englishButton" text="%toolbar.language.english" styleClass="joined-right" minWidth="-Infinity" toggleGroup="$languageGroup">
                    <tooltip>
                        <Tooltip text="%toolbar.language.english.tooltip"/>
                    </tooltip>
                </ToggleButton>
            </HBox>
            <MenuButton fx:id="themeButton" text="%toolbar.theme" minWidth="-Infinity">
                <graphic><Icon glyph="THEME"/></graphic>
                <fx:define>
                    <ToggleGroup fx:id="themeGroup"/>
                </fx:define>
                <items>
                    <RadioMenuItem fx:id="systemThemeItem" text="%toolbar.theme.system" toggleGroup="$themeGroup"/>
                    <RadioMenuItem fx:id="lightThemeItem" text="%toolbar.theme.light" toggleGroup="$themeGroup"/>
                    <RadioMenuItem fx:id="darkThemeItem" text="%toolbar.theme.dark" toggleGroup="$themeGroup"/>
                </items>
            </MenuButton>
            <Button fx:id="aboutButton" text="%toolbar.about" minWidth="-Infinity" onAction="#onAbout">
                <graphic><Icon glyph="ABOUT"/></graphic>
            </Button>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.25" styleClass="workspace">
            <VBox fx:id="queuePanel" styleClass="panel" minWidth="220" prefWidth="270" SplitPane.resizableWithParent="false">
                <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="queueTitleLabel" styleClass="section-header" minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="queueRemainingLabel" styleClass="panel-note" minWidth="-Infinity"/>
                </HBox>
                <ListView fx:id="queueList" VBox.vgrow="ALWAYS"/>
                <HBox styleClass="panel-footer" alignment="CENTER_LEFT">
                    <Button fx:id="removeFromQueueButton" text="%queue.remove" minWidth="-Infinity" styleClass="button-danger" onAction="#onRemoveFromQueue">
                        <graphic><Icon glyph="REMOVE"/></graphic>
                    </Button>
                </HBox>
            </VBox>
            <VBox fx:id="tracksPanel" styleClass="panel">
                <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="6">
                    <Label fx:id="tracksTitleLabel" styleClass="section-header" minWidth="-Infinity"/>
                    <Label fx:id="tracksFileLabel" styleClass="file-name" textOverrun="CENTER_ELLIPSIS" ellipsisString="…"/>
                    <Label fx:id="tracksInfoLabel" styleClass="panel-note" minWidth="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="trackCountLabel" styleClass="panel-note" minWidth="-Infinity"/>
                    <Button fx:id="applyToAllButton" text="%tracks.applyToAll" minWidth="-Infinity" onAction="#onApplyToAll">
                        <tooltip>
                            <Tooltip text="%tracks.applyToAll.tooltip"/>
                        </tooltip>
                    </Button>
                </HBox>
                <TableView fx:id="trackTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="keepColumn" text="%table.column.keep" minWidth="60" prefWidth="60" maxWidth="60"/>
                        <TableColumn fx:id="indexColumn" text="%table.column.index" minWidth="32" prefWidth="32" maxWidth="32"/>
                        <TableColumn fx:id="typeColumn" text="%table.column.type" minWidth="76" prefWidth="76" maxWidth="76"/>
                        <TableColumn fx:id="codecColumn" text="%table.column.codec" minWidth="100" prefWidth="170"/>
                        <TableColumn fx:id="channelsColumn" text="%table.column.channels" minWidth="68" prefWidth="68" maxWidth="68"/>
                        <TableColumn fx:id="languageColumn" text="%table.column.language" minWidth="72" prefWidth="72" maxWidth="72"/>
                        <TableColumn fx:id="titleColumn" text="%table.column.title" minWidth="70" prefWidth="200"/>
                        <TableColumn fx:id="actionColumn" text="%table.column.action" minWidth="140" prefWidth="140" maxWidth="140"/>
                        <TableColumn fx:id="defaultColumn" text="%table.column.default" minWidth="74" prefWidth="74" maxWidth="74"/>
                    </columns>
                </TableView>
                <HBox styleClass="panel-footer" alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="outputLabel" text="%output.label" styleClass="field-label" minWidth="-Infinity"/>
                    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <TextField fx:id="outputField" HBox.hgrow="ALWAYS" styleClass="path-field,joined-left"/>
                        <Button fx:id="changeOutputButton" text="%output.change" minWidth="-Infinity" styleClass="joined-right" onAction="#onChangeOutput"/>
                    </HBox>
                    <Button fx:id="outputFolderButton" text="%output.folderForAll" minWidth="-Infinity" onAction="#onOutputFolderForAll">
                        <tooltip>
                            <Tooltip text="%output.folderForAll.tooltip"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <VBox styleClass="action-bar" spacing="8">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="startButton" text="%actions.start" minWidth="-Infinity" styleClass="button-primary" onAction="#onStart">
                    <graphic><Icon glyph="START"/></graphic>
                </Button>
                <Button fx:id="quickConvertButton" text="%actions.quickConvert" minWidth="-Infinity" styleClass="button-warning" onAction="#onQuickConvert">
                    <graphic><Icon glyph="QUICK"/></graphic>
                    <tooltip>
                        <Tooltip text="%actions.quickConvert.tooltip"/>
                    </tooltip>
                </Button>
                <Button fx:id="cancelButton" text="%actions.cancel" minWidth="-Infinity" onAction="#onCancel"/>
                <VBox HBox.hgrow="ALWAYS" spacing="3" styleClass="progress-info">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="progressStatusLabel" styleClass="progress-status"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="progressPercentLabel" styleClass="progress-percent" minWidth="-Infinity"/>
                    </HBox>
                    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <ListView fx:id="logList" styleClass="console" minHeight="96" prefHeight="96"/>
        </VBox>
    </bottom>
</BorderPane>