<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pl.audiofix.ui.AboutController" spacing="10" prefWidth="520">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label fx:id="appVersionLabel" styleClass="about-title"/>
    <Label text="%about.description" wrapText="true"/>
    <Label fx:id="authorLabel" text="%about.author"/>
    <Hyperlink fx:id="repositoryLink" onAction="#onRepository"/>
    <Separator/>
    <Label fx:id="ffmpegLabel" wrapText="true"/>
    <Label fx:id="environmentLabel" wrapText="true"/>
    <Separator/>
    <Label text="%about.licenses"/>
    <TextArea fx:id="licensesArea" editable="false" wrapText="true" prefRowCount="10" VBox.vgrow="ALWAYS"/>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="logsButton" text="%about.logs" minWidth="-Infinity" onAction="#onLogs">
            <tooltip>
                <Tooltip text="%about.logs.tooltip"/>
            </tooltip>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="copyButton" text="%about.copy" minWidth="-Infinity" onAction="#onCopy"/>
        <Button fx:id="closeButton" text="%about.close" minWidth="-Infinity" onAction="#onClose" cancelButton="true" defaultButton="true"/>
    </HBox>
</VBox>
